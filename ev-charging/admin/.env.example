VITE_API_URL="http://localhost:3001/api"
VITE_SOCKET_URL="http://localhost:3001"

# Optional: enables configuring OCPP forwarding if the backend DB is down.
# Sent as header: X-Admin-Maintenance-Token
VITE_ADMIN_MAINTENANCE_TOKEN=""

# Optional: enable admin devtools actions (emit socket events from backend)
VITE_DEVTOOLS_TOKEN=""

# Optional (enables station create/edit map picker)
VITE_GOOGLE_MAPS_KEY="YOUR_GOOGLE_MAPS_API_KEY"
