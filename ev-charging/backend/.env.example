##############################
# Backend environment example #
##############################

# Postgres connection string used by Prisma + pg adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# JWT secrets used by auth routes / middleware.
JWT_SECRET="change-me-dev"
JWT_REFRESH_SECRET="change-me-dev-refresh"

# Server port
PORT=3001

# Admin panel URL(s) allowed by CORS
ADMIN_URL="http://localhost:5173"

# User app URL allowed by CORS
USER_APP_URL="http://localhost:5174"

# Public base URL used to build absolute URLs for uploaded files
# (leave empty in dev to default to http://localhost:3001)
PUBLIC_BASE_URL=""

# Optional: OCPP server URL (if using the OCPP bridge)
# OCPP_SERVER_URL="ws://localhost:9000"

# Legacy OCPP outbound bridge client (Option B). Keep disabled for Option A.
OCPP_BRIDGE_ENABLED=false

# External OCPP server admin HTTP API (Option A)
OCPP_ADMIN_HTTP_BASE_URL="http://35.224.174.50:9000"
OCPP_ADMIN_HTTP_TOKEN=""

# OCPP server forwarding targets (configure on OCPP server via /admin/forwarding)
# These are here for reference. The backend uses INTERNAL_TOKEN to verify incoming posts.
# INTERNAL_TOKEN must match what is configured on the OCPP server.
INTERNAL_TOKEN="change-me"

# Optional: allows configuring the OCPP server forwarding even if the DB is down.
# Send as header X-Admin-Maintenance-Token
ADMIN_MAINTENANCE_TOKEN=""

# Optional: enable admin devtools endpoints (emit socket events for UI testing)
# Required header: X-Devtools-Token
DEVTOOLS_TOKEN=""

# Seed defaults
# small | medium | large
SEED_SCALE=medium

# Google OAuth (placeholders)
# Create OAuth 2.0 Client in Google Cloud Console.
# Authorized redirect URI (local dev):
#   http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL="http://localhost:3001/api/auth/google/callback"

# After Google login, backend will redirect back to the user app with tokens.
USER_APP_AUTH_REDIRECT_URL="http://localhost:5174/auth/callback"
